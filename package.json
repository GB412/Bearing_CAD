{
  "name": "bearingcad-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone sliding and rolling bearing parametric CAD workbenches",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "python -m unittest discover -s tests -v",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "test:unit:js": "npm run test:unit:js:rolling && npm run test:unit:js:sliding",
    "test:unit:js:rolling": "node --test tests-js/rolling/rolling_manifest.test.js tests-js/rolling/rolling_robas_geometry.test.js",
    "test:unit:js:sliding": "node --test tests-js/sliding/geometry.test.js tests-js/sliding/cad03_geometry.test.js"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "vite": "7.1.7",
    "@playwright/test": "1.55.0"
  }
}
